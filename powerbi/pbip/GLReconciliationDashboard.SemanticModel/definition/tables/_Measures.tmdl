	/// Against 15.507, the 5% critical value on 8 degrees of freedom.
	measure 'Chi Square' = SUM(benford_by_dimension[chi_square])
		formatString: 0.00
		lineageTag: c342400f-6bfd-5e32-834d-708936ce64a8
		displayFolder: Journal Risk

	/// Greys out the tests that fire at the same rate on entries no human chose the timing of - they are describing the ledger, not the behaviour.
	measure 'Flag Colour' =
			VAR vDiscriminates = MAX(journal_risk_flags[discriminates])
			RETURN IF(vDiscriminates = 1, "#FF5C7A", "#454A82")
		lineageTag: 7d219bbf-d020-5c44-b3d9-9bfed4fb6238
		displayFolder: Journal Risk

	/// Reddens a cost centre whose first-digit distribution exceeds the 5% critical value.
	measure 'Benford Colour' =
			VAR vChi = MAX(benford_by_dimension[chi_square])
			RETURN IF(vChi > 15.507, "#FF5C7A", "#454A82")
		lineageTag: 940ebef2-3b07-57e1-82d3-c6094b149a9d
		displayFolder: Journal Risk

	measure 'Review Reference' = FORMAT(SUM(risk_headline[for_review_share_of_manual]), "0.0%") & " of manual entries   " & FORMAT(SUM(risk_headline[for_review_value]), "$#,0")
		lineageTag: 2c395dc0-3901-55ab-a5d1-4b4466db5e82
		displayFolder: Journal Risk

	measure 'Manual Reference' = FORMAT(SUM(risk_headline[manual_share]), "0.0%") & " of " & FORMAT(SUM(risk_headline[entries]), "#,0") & " entries, worth " & FORMAT(SUM(risk_headline[manual_value]), "$#,0")
		lineageTag: 199c0fc0-3fe9-56c5-a0f6-8fcf425b3e13
		displayFolder: Journal Risk

	measure 'Self Approval Reference' = FORMAT(SUM(risk_headline[self_approval_top2_share]), "0%") & " of it is two people   " & FORMAT(SUM(risk_headline[self_approved_value]), "$#,0")
		lineageTag: 52d545d1-9952-5d91-b38d-25a175303453
		displayFolder: Journal Risk

	measure 'Avoidance Reference' = FORMAT(SUM(risk_headline[threshold_avoidance_value]), "$#,0") & " sitting just under an approval limit"
		lineageTag: 3289cbc8-919c-5b52-bb40-2704b817dd9b
		displayFolder: Journal Risk

	/// The controls headline as a deterministic sentence.
	measure 'Risk Insight' =
			VAR vEntries = SUM(risk_headline[entries])
			VAR vManual = SUM(risk_headline[manual_entries])
			VAR vManualShare = SUM(risk_headline[manual_share])
			VAR vUseful = SUM(risk_headline[flags_that_discriminate])
			VAR vUseless = SUM(risk_headline[flags_that_do_not])
			VAR vWeekendManual = SUM(risk_headline[weekend_manual_rate])
			VAR vWeekendAuto = SUM(risk_headline[weekend_interfaced_rate])
			VAR vSelf = SUM(risk_headline[self_approved])
			VAR vTop2 = SUM(risk_headline[self_approval_top2_share])
			VAR vWorst = MAX(risk_headline[self_approval_worst])
			VAR vAvoid = SUM(risk_headline[threshold_avoidance])
			VAR vAvoidValue = SUM(risk_headline[threshold_avoidance_value])
			VAR vReview = SUM(risk_headline[for_review])
			VAR vBenford = SUM(risk_headline[benford_deviating])
			VAR vGroups = SUM(risk_headline[benford_groups])
			RETURN
			    "All " & FORMAT(vEntries, "#,0") & " entries were tested, not a sample of "
			        & "forty. " & FORMAT(vManual, "#,0") & " are manual ("
			        & FORMAT(vManualShare, "0.0%") & ") and every other test is conditioned "
			        & "on that. " & FORMAT(vUseful, "0") & " of "
			        & FORMAT(vUseful + vUseless, "0") & " tests discriminate on this "
			        & "ledger: weekend posting runs " & FORMAT(vWeekendManual, "0.0%")
			        & " on manual entries against " & FORMAT(vWeekendAuto, "0.0%")
			        & " on interfaced ones, so it is reported as a non-finding rather than "
			        & "as several hundred exceptions. What is real: " & FORMAT(vSelf, "0")
			        & " entries were posted and approved by the same person, "
			        & FORMAT(vTop2, "0%") & " of them by two people with " & vWorst
			        & " the worst - a bottleneck being worked around, not a policy nobody "
			        & "understands. " & FORMAT(vAvoid, "0") & " entries ("
			        & FORMAT(vAvoidValue, "$#,0") & ") sit just under an approval limit. "
			        & FORMAT(vReview, "0") & " entries make the review list, and "
			        & FORMAT(vBenford, "0") & " of " & FORMAT(vGroups, "0")
			        & " cost centres deviate from Benford."
		lineageTag: d1ddfe7d-7ee2-575c-82f4-bc0c3d2b4525
		displayFolder: Journal Risk

