table _Measures
	lineageTag: 9b97db27-2385-493b-93cf-5c0c255cd862

	measure 'ERP Total' = SUM(gl_control_totals[erp_total])
		formatString: \$#,0.00
		lineageTag: 89e59dbd-1ecd-4be4-9827-d7fba340d812

	measure 'Subledger Total' = SUM(gl_control_totals[subledger_total])
		formatString: \$#,0.00
		lineageTag: 49c59d09-1689-4407-bff9-832b38c072da

	measure 'Variance $' = [Subledger Total] - [ERP Total]
		formatString: \$#,0.00;(\$#,0.00)
		lineageTag: 9ade3a5a-9fe1-49d7-b485-00663bbef38b

	measure 'Variance %' = DIVIDE([Variance $], ABS([ERP Total]))
		formatString: 0.00%
		lineageTag: ce1f8c06-a985-410b-8ef1-3e5595fec5c1

	measure 'Accounts Out of Tolerance' =
			VAR vThreshold = 0.005  // 0.5% materiality
			RETURN
			    CALCULATE(
			        DISTINCTCOUNT(gl_control_totals[account_id]),
			        FILTER(
			            gl_control_totals,
			            ABS(DIVIDE(gl_control_totals[subledger_total] - gl_control_totals[erp_total], ABS(gl_control_totals[erp_total]))) > vThreshold
			        )
			    )
		formatString: #,0
		lineageTag: 200b2b28-215c-4a1d-aeb2-a90509afd6cb

	measure 'Total Exceptions' = COUNTROWS(gl_reconciliation_exceptions)
		formatString: #,0
		lineageTag: d99a21a0-f05c-4d61-b01a-063db6e18fdf

	measure 'Exception Dollar Impact' =
			SUMX(
			    gl_reconciliation_exceptions,
			    ABS(COALESCE(gl_reconciliation_exceptions[variance_amount], gl_reconciliation_exceptions[erp_amount]))
			)
		formatString: \$#,0.00
		lineageTag: 6d2c88cd-e009-469e-8658-b9abefde9d32

	measure 'Missing Count' = CALCULATE([Total Exceptions], gl_reconciliation_exceptions[exception_type] = "Missing in subledger")
		formatString: #,0
		lineageTag: 7c416b4b-fb0d-4dbb-9bd5-1e6b1097d7ca

	measure 'Timing Diff Count' = CALCULATE([Total Exceptions], gl_reconciliation_exceptions[exception_type] = "Timing difference")
		formatString: #,0
		lineageTag: 36d7c3a3-4c38-4cd6-95f1-7f06f051eb67

	measure 'Amount Mismatch Count' = CALCULATE([Total Exceptions], gl_reconciliation_exceptions[exception_type] = "Amount mismatch")
		formatString: #,0
		lineageTag: 419e5d59-6ba8-49f8-8b47-1c6557676999

	measure 'Duplicate Count' = CALCULATE([Total Exceptions], gl_reconciliation_exceptions[exception_type] = "Duplicate posting")
		formatString: #,0
		lineageTag: 47c482ee-00ec-4785-b4ae-bee2e495a4e0

	measure 'ERP Txn Count' = COUNTROWS(fact_erp_gl)
		formatString: #,0
		lineageTag: 2c692c79-6834-4e26-96fa-6dd9cb834b6a

	measure 'Match Rate' =
			VAR vTotalErpTxns = COUNTROWS(fact_erp_gl)
			RETURN
			    DIVIDE(vTotalErpTxns - [Total Exceptions], vTotalErpTxns)
		formatString: 0.0%
		lineageTag: ed7c1a53-ab55-4e1b-aea8-07d65bd3f8f7

	measure 'Match Rate Target' = 0.98
		formatString: 0.0%
		lineageTag: 6dbe3b3e-8b80-49bb-93eb-ad3e5cea3811

	measure 'Cloud Billed $' = SUM(focus_coverage[billed_total])
		formatString: \$#,0
		lineageTag: 3d8446c4-daa0-4c4d-982f-67f6b966d8e9

	measure 'Allocation Coverage %' = DIVIDE(SUM(focus_coverage[allocated_total]), SUM(focus_coverage[billed_total]))
		formatString: 0.0%
		lineageTag: 0e923f17-0663-41b1-a27c-0ca282265d30

	measure 'Untagged Spend $' = SUM(focus_coverage[untagged_total])
		formatString: \$#,0
		lineageTag: 0c0aacf6-7103-4d42-85ef-22439b656d7d

	measure 'Cloud Exceptions' = COUNTROWS(focus_exceptions)
		formatString: #,0
		lineageTag: b0fe40c4-bc32-4d25-897f-5fec3bc98df1

	measure 'Cloud Exception $' = SUMX(focus_exceptions, ABS(COALESCE(focus_exceptions[variance_amount], focus_exceptions[erp_amount])))
		formatString: \$#,0
		lineageTag: c939149e-a0d8-4082-8156-beeffea95edb

	/// Exceptions in the previous close period. Blank at the report grain, which is correct: 'the month before all months' is not a month.
	measure 'Exceptions PM' =
			VAR vCurIdx = SELECTEDVALUE(dim_period[period_index])
			RETURN
			    IF(
			        NOT ISBLANK(vCurIdx),
			        CALCULATE([Total Exceptions], ALL(dim_period), dim_period[period_index] = vCurIdx - 1)
			    )
		formatString: #,0
		displayFolder: Comparison
		lineageTag: 624ffd89-43f0-52d9-907e-2ff034f15ff4

	/// Prior-period dollar impact.
	measure 'Exception Impact PM' =
			VAR vCurIdx = SELECTEDVALUE(dim_period[period_index])
			RETURN
			    IF(
			        NOT ISBLANK(vCurIdx),
			        CALCULATE([Exception Dollar Impact], ALL(dim_period), dim_period[period_index] = vCurIdx - 1)
			    )
		formatString: \$#,0
		displayFolder: Comparison
		lineageTag: aa081743-15e6-5b73-b81a-79025ffe258b

	/// Signed, so the format string carries the direction and the card does not need a second field to say which way it moved.
	measure 'Exceptions MoM %' = DIVIDE([Total Exceptions] - [Exceptions PM], [Exceptions PM])
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: Comparison
		lineageTag: 01579507-7736-53dc-be36-29bd14b2dbad

	/// Positive means impact grew. Same sign convention as Exceptions MoM %:
	/// both report change against prior, so a rise in a bad number reads positive.
	measure 'Exception Impact MoM %' = DIVIDE([Exception Dollar Impact] - [Exception Impact PM], [Exception Impact PM])
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: Comparison
		lineageTag: 99de777c-3300-5a7b-9cd8-457fd5d69cbd

	/// The half of the KPI that was missing: 95.7% against what?
	measure 'Match Rate vs Target' = [Match Rate] - [Match Rate Target]
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: Verdict
		lineageTag: 6659f21d-0e4a-5c56-b544-b58f98c6588c

	/// The model decides what 'bad' means, once, instead of every reader deciding for themselves in the meeting.
	measure 'Match Rate Status' =
			VAR vGap = [Match Rate] - [Match Rate Target]
			RETURN
			    SWITCH(
			        TRUE(),
			        ISBLANK([Match Rate]), "No data",
			        vGap >= 0, "On target",
			        vGap >= -0.01, "Watch",
			        "Off target"
			    )
		displayFolder: Verdict
		lineageTag: d3daeb5b-6164-5980-853c-d411d7d074e1

	/// Bind to Conditional formatting -> Field value. Hex strings are the Meridian Nocturne semantic colours, so the report and the theme cannot drift apart.
	measure 'Match Rate Colour' =
			SWITCH(
			    [Match Rate Status],
			    "On target", "#3DD68C",
			    "Watch", "#F5A524",
			    "No data", "#454A82",
			    "#FF5C7A"
			)
		displayFolder: Verdict
		lineageTag: db04b965-a291-56e9-9921-2767a5c7fd50

	/// Reference label under the callout on the new card visual.
	measure 'Match Rate Reference' =
			VAR vGap = [Match Rate vs Target]
			VAR vAbove = vGap >= 0
			RETURN
			    "Target " & FORMAT([Match Rate Target], "0.0%") & "   "
			        & IF(vAbove, "▲", "▼") & " "
			        & FORMAT(ABS(vGap) * 100, "0.0") & " pts" & IF(vAbove, " over", " under")
		displayFolder: Verdict
		lineageTag: 1fcee59c-2fc2-5ba5-90ab-81c7f29ec0d1

	/// Falls back to naming the span rather than showing an empty line when no
	/// single period is selected.
	///
	/// It used to fall back to the string "230 across six periods". That was
	/// true of the unfiltered book on the day it was typed and of nothing else:
	/// filter to two accounts, or one cost centre, and the card above it read
	/// 41 while the line beneath it still said 230 across six periods. A
	/// hardcoded number under a live one is worse than no reference at all,
	/// because the reader has no way to tell which of the two moved.
	///
	/// Periods are counted on the exceptions themselves, not on dim_period: an
	/// account filter does not touch the period table, so counting there would
	/// claim six periods for a selection that only reaches two.
	measure 'Exceptions Reference' =
			VAR vPrior = [Exceptions PM]
			VAR vPeriods = DISTINCTCOUNT(gl_reconciliation_exceptions[period])
			RETURN
			    IF(
			        ISBLANK(vPrior),
			        "Across " & FORMAT(vPeriods, "#,0") & " period" & IF(vPeriods = 1, "", "s") & " in scope",
			        "Prior period " & FORMAT(vPrior, "#,0") & "   "
			            & IF([Total Exceptions] <= vPrior, "▼", "▲") & " "
			            & FORMAT(ABS([Total Exceptions] - vPrior), "#,0")
			    )
		displayFolder: Verdict
		lineageTag: 19f29d9d-01c0-5a9a-a131-32fcad4c26c8

	/// vPrior-period dollar impact, formatted for the card reference label.
	measure 'Exception Impact Reference' =
			VAR vPrior = [Exception Impact PM]
			RETURN
			    IF(
			        ISBLANK(vPrior),
			        "Across " & FORMAT(DISTINCTCOUNT(gl_reconciliation_exceptions[period]), "#,0")
			            & " periods in scope",
			        "Prior period " & FORMAT(vPrior, "\$#,0") & "   "
			            & IF([Exception Dollar Impact] <= vPrior, "▼", "▲") & " "
			            & FORMAT(ABS([Exception Dollar Impact] - vPrior), "\$#,0")
			    )
		displayFolder: Verdict
		lineageTag: 2674a454-fff8-54ce-a6bc-269e35b10227

	/// States the threshold on the card, so the number is not read without it.
	measure 'Tolerance Reference' = "0.5% materiality on " & FORMAT(DISTINCTCOUNT(gl_control_totals[account_id]), "#,0") & " accounts"
		displayFolder: Verdict
		lineageTag: 6b370956-6861-5a4e-9c2a-c2a1f07611bb

	/// Highlights the largest value on the axis and recedes the rest.
	/// The bare ALLSELECTED() is what makes this work inside a conditional
	/// format: it restores the VISUAL's filter context, so VALUES() is the
	/// axis rather than the single data point. Iterating the column alone
	/// leaves the point's own filter in place and every bar matches itself;
	/// iterating the table walks rows, which is not the axis unless the
	/// dimension happens to have one row per value.
	measure 'Exception Type Colour' =
			VAR vHere = [Total Exceptions]
			VAR vExtreme =
			    CALCULATE(
			        MAXX(VALUES(gl_reconciliation_exceptions[exception_type]), [Total Exceptions]),
			        ALLSELECTED()
			    )
			RETURN
			    IF(vHere = vExtreme, "#FF5C7A", "#454A82")
		displayFolder: Verdict
		lineageTag: 8d249e38-8a18-5d46-9a1d-79d4fce0c12c

	/// Highlights the largest value on the axis and recedes the rest.
	/// The bare ALLSELECTED() is what makes this work inside a conditional
	/// format: it restores the VISUAL's filter context, so VALUES() is the
	/// axis rather than the single data point. Iterating the column alone
	/// leaves the point's own filter in place and every bar matches itself;
	/// iterating the table walks rows, which is not the axis unless the
	/// dimension happens to have one row per value.
	measure 'Period Impact Colour' =
			VAR vHere = [Exception Dollar Impact]
			VAR vExtreme =
			    CALCULATE(
			        MAXX(VALUES(dim_period[period]), [Exception Dollar Impact]),
			        ALLSELECTED()
			    )
			RETURN
			    IF(vHere = vExtreme, "#FF5C7A", "#454A82")
		displayFolder: Verdict
		lineageTag: d12f9fa2-a275-5627-a2bd-e8235e4e2a7a

	/// A deterministic narrative. Smart Narrative would write this too, but this version is a measure: it can be unit tested and it cannot drift.
	measure 'Close Insight' =
			VAR vRate = [Match Rate]
			VAR vGap = vRate - [Match Rate Target]
			VAR vWorst =
			    TOPN(1, VALUES(gl_reconciliation_exceptions[exception_type]), [Total Exceptions], DESC)
			VAR vWorstType = MAXX(vWorst, gl_reconciliation_exceptions[exception_type])
			VAR vWorstCount = CALCULATE([Total Exceptions], gl_reconciliation_exceptions[exception_type] = vWorstType)
			VAR vWorstShare = DIVIDE(vWorstCount, [Total Exceptions])
			VAR vWorstImpact =
			    CALCULATE([Exception Dollar Impact], gl_reconciliation_exceptions[exception_type] = vWorstType)
			RETURN
			    "Match rate " & FORMAT(vRate, "0.0%") & " against a " & FORMAT([Match Rate Target], "0.0%")
			        & " target — " & IF(vGap >= 0, "on target", FORMAT(ABS(vGap) * 100, "0.0") & " pts short")
			        & ". " & vWorstType & " is the largest class at "
			        & FORMAT(vWorstShare, "0.0%") & " of " & FORMAT([Total Exceptions], "#,0")
			        & " exceptions, carrying " & FORMAT(vWorstImpact, "\$#,0") & " of its own impact."
		displayFolder: Verdict
		lineageTag: ffafd29d-b779-5832-a8a2-a123a06abdc3

	/// Every entry in the ledger, not a sample of forty pulled by hand - which is the entire argument for running controls in the warehouse.
	measure 'Entries Tested' = SUM(risk_headline[entries])
