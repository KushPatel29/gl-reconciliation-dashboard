	measure 'Owner Mean' = SUM(exception_sla_by_owner[mean_days])
		formatString: 0.0
		lineageTag: 75125295-9be9-5483-a305-19d882a14d66
		displayFolder: Exception Ageing

	measure 'Owner Breach Rate' = SUM(exception_sla_by_owner[breach_rate])
		formatString: 0.0%
		lineageTag: c81eab3c-2794-5d52-a691-5e3b97ea62a5
		displayFolder: Exception Ageing

	measure 'Opened' = SUM(exception_throughput[opened])
		formatString: #,0
		lineageTag: 1e29dc88-1990-530b-8f65-d48a6d0ef217
		displayFolder: Exception Ageing

	measure 'Cleared' = SUM(exception_throughput[cleared])
		formatString: #,0
		lineageTag: f704bae6-c44e-585b-bfa0-0f80f4998814
		displayFolder: Exception Ageing

	measure 'Backlog' = SUM(exception_throughput[backlog])
		formatString: #,0
		lineageTag: 51aae632-f017-5aaa-80d3-dbf47bd031de
		displayFolder: Exception Ageing

	measure 'Method Count' = SUM(exception_clear_methods[count])
		formatString: #,0
		lineageTag: 94690072-80da-5405-8e7e-e5c1dbef9d7e
		displayFolder: Exception Ageing

	/// Reddens any queue whose median exception takes longer than the SLA allows - measured against the published target, not against the other owners.
	measure 'Owner Colour' =
			VAR vHere = [Owner Median]
			VAR vSla = CALCULATE(MAX(ageing_headline[sla_days]), ALL(ageing_headline))
			RETURN IF(vHere > vSla, "#FF5C7A", "#454A82")
		lineageTag: 32992c65-c956-5f93-93f3-b5768ae5ed03
		displayFolder: Exception Ageing

	measure 'Open Reference' = FORMAT(SUM(ageing_headline[still_open]), "0") & " open of " & FORMAT(SUM(ageing_headline[exceptions]), "0") & "   oldest " & FORMAT(SUM(ageing_headline[oldest_open_days]), "0") & " days"
		lineageTag: e1383ef0-7aaf-51e9-b4b4-7eedd9826d44
		displayFolder: Exception Ageing

	measure 'Clear Reference' = "mean " & FORMAT(SUM(ageing_headline[mean_days_to_clear]), "0.0") & ", P90 " & FORMAT(SUM(ageing_headline[p90_days_to_clear]), "0") & ", worst " & FORMAT(SUM(ageing_headline[worst_days_to_clear]), "0")
		lineageTag: f6f79179-220a-5dd8-a77a-b5324fec4fa0
		displayFolder: Exception Ageing

	measure 'Breach Reference' = FORMAT(SUM(ageing_headline[breaches]), "0") & " of " & FORMAT(SUM(ageing_headline[exceptions]), "0") & " past the " & FORMAT(SUM(ageing_headline[sla_days]), "0") & "-day target"
		lineageTag: ae5ddba2-5971-5df2-a4cd-016498368d7d
		displayFolder: Exception Ageing

	measure 'Absorbed Reference' = FORMAT(SUM(ageing_headline[absorbed]), "0") & " closed without a fix, carrying " & FORMAT(SUM(ageing_headline[absorbed_exposure]), "$#,0")
		lineageTag: 568fbb30-cc33-5a2a-bd8d-e5b70300a9c1
		displayFolder: Exception Ageing

	/// The close-quality headline as a deterministic sentence.
	measure 'Ageing Insight' =
			VAR vTotal = SUM(ageing_headline[exceptions])
			VAR vOpen = SUM(ageing_headline[still_open])
			VAR vExposure = SUM(ageing_headline[open_exposure])
			VAR vMedian = SUM(ageing_headline[median_days_to_clear])
			VAR vMean = SUM(ageing_headline[mean_days_to_clear])
			VAR vBreach = SUM(ageing_headline[breach_rate])
			VAR vSlow = MAX(ageing_headline[slowest_owner])
			VAR vSpread = SUM(ageing_headline[owner_spread_multiple])
			VAR vFast = MAX(ageing_headline[fastest_owner])
			VAR vTailOwner = MAX(ageing_headline[worst_tail_owner])
			VAR vTailMedian = SUM(ageing_headline[worst_tail_median])
			VAR vTailMean = SUM(ageing_headline[worst_tail_mean])
			VAR vAbsorbed = SUM(ageing_headline[absorbed])
			VAR vAbsorbedShare = SUM(ageing_headline[absorbed_share])
			VAR vGrew = SUM(ageing_headline[months_backlog_grew])
			RETURN
			    FORMAT(vTotal, "0") & " exceptions were raised and " & FORMAT(vOpen, "0")
			        & " are still open, carrying " & FORMAT(vExposure, "$#,0")
			        & ". The median clears in " & FORMAT(vMedian, "0")
			        & " days against a mean of " & FORMAT(vMean, "0.0")
			        & ", and " & FORMAT(vBreach, "0.0%") & " breached the target. "
			        & vSlow & " takes " & FORMAT(vSpread, "0.0")
			        & "x as long as " & vFast & " on the same work, while " & vTailOwner
			        & " has the opposite problem - a median of " & FORMAT(vTailMedian, "0")
			        & " days against a mean of " & FORMAT(vTailMean, "0.0")
			        & ", which is a long tail rather than a slow queue and needs a "
			        & "different fix. " & FORMAT(vAbsorbed, "0") & " ("
			        & FORMAT(vAbsorbedShare, "0%")
			        & ") were closed by accepting or writing them off, so they return next "
			        & "month; the backlog grew in " & FORMAT(vGrew, "0") & " months."
		lineageTag: 3a8ad57b-3685-5945-9874-22106c9c410d
		displayFolder: Exception Ageing

	measure 'KPI SVG Match Rate | Match Rate Reference | Match Rate Colour' =
			VAR vValue = [Match Rate]
			VAR vShown = IF(ISBLANK(vValue), "—", FORMAT(vValue, "0.0%"))
			VAR vCaptionRaw = SUBSTITUTE(SUBSTITUTE(COALESCE([Match Rate Reference], ""), "&", "&amp;"), "<", "&lt;")
			VAR vCaption = IF(LEN(vCaptionRaw) > 58, LEFT(vCaptionRaw, 56) & "…", vCaptionRaw)
			VAR vAccent = COALESCE([Match Rate Colour], "#8B8BFF")
			VAR vValueFill = vAccent
			VAR vW = ROUND(264 * MAX(0, MIN(1, COALESCE(vValue, 0))), 0)
			VAR vSvg =
			    "<svg xmlns='http://www.w3.org/2000/svg' width='296' height='112' viewBox='0 0 296 112'>"
			        & "<rect x='0' y='18' width='3' height='76' rx='1.5' fill='" & vAccent & "'/>"
			        & "<text x='16' y='28' font-family='Segoe UI' font-size='11' fill='#A6ABD1'>Match Rate</text>"
			        & "<text x='16' y='64' font-family='Segoe UI Light' font-size='30' fill='" & vValueFill & "'>" & vShown & "</text>"
			        & "<rect x='16' y='76' width='264' height='6' rx='3' fill='#2C2F55'/>" & "<rect x='16' y='76' width='" & vW & "' height='6' rx='3' fill='" & vAccent & "'/>"
			        & "<text x='16' y='100' font-family='Segoe UI' font-size='10' fill='#8B90B8'>" & vCaption & "</text>"
			        & "</svg>"
			RETURN
			    "data:image/svg+xml;utf8," & SUBSTITUTE(SUBSTITUTE(vSvg, "%", "%25"), "#", "%23")
		lineageTag: 3ef23dc3-2dd2-539f-a4ec-12caa04e0478
		dataCategory: ImageUrl
		displayFolder: Report UI

