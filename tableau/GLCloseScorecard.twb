  <worksheets>
    <worksheet name='Variance by Account'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontname='Segoe UI Semibold' fontsize='11' bold='true'>Absolute variance by account ($)</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Control Totals' name='federated.controltotals' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='federated.controltotals'>
          <column datatype='string' name='[account_name]' role='dimension' type='nominal' />
          <column datatype='real' name='[variance_amount]' role='measure' type='quantitative' />
          <column datatype='integer' name='[out_of_tolerance]' role='measure' type='quantitative' />
          <column datatype='string' name='[period]' role='dimension' type='nominal' />
          <column caption='Abs Variance' datatype='real' name='[Calculation_absvariance]' role='measure' type='quantitative'>
            <calculation class='tableau' formula='ABS([variance_amount])' />
          </column>
          <column caption='Tolerance Status' datatype='string' name='[Calculation_tolerance]' role='dimension' type='nominal'>
            <calculation class='tableau' formula='IF [out_of_tolerance] = 1 THEN &quot;Out of tolerance&quot; ELSE &quot;Within tolerance&quot; END' />
          </column>
          <column caption='Period Filter' datatype='boolean' name='[Calculation_ctlperiod]' role='dimension' type='ordinal'>
            <calculation class='tableau' formula='[Parameters].[Parameter 1] = &quot;All&quot; OR [period] = [Parameters].[Parameter 1]' />
          </column>
          <column-instance column='[account_name]' derivation='None' name='[none:account_name:nk]' pivot='key' type='nominal' />
          <column-instance column='[Calculation_absvariance]' derivation='Sum' name='[sum:Calculation_absvariance:qk]' pivot='key' type='quantitative' />
          <column-instance column='[Calculation_tolerance]' derivation='None' name='[none:Calculation_tolerance:nk]' pivot='key' type='nominal' />
          <column-instance column='[Calculation_ctlperiod]' derivation='None' name='[none:Calculation_ctlperiod:ok]' pivot='key' type='ordinal' />
          </datasource-dependencies>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Period' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;All&quot;'>
              <calculation class='tableau' formula='&quot;All&quot;' />
            </column>
          </datasource-dependencies>
        <filter class='categorical' column='[federated.controltotals].[none:Calculation_ctlperiod:ok]'>
          <groupfilter function='member' level='[none:Calculation_ctlperiod:ok]' member='true' />
        </filter>
        <sort class='computed' column='[federated.controltotals].[none:account_name:nk]' direction='DESC' using='[federated.controltotals].[sum:Calculation_absvariance:qk]' />
        <slices>
          <column>[federated.controltotals].[none:Calculation_ctlperiod:ok]</column>
        </slices>
          <aggregation value='true' />
        </view>
      <style />
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Bar' />
            <encodings>
              <color column='[federated.controltotals].[none:Calculation_tolerance:nk]' />
            </encodings>
          </pane>
        </panes>
        <rows>[federated.controltotals].[none:account_name:nk]</rows>
        <cols>[federated.controltotals].[sum:Calculation_absvariance:qk]</cols>
      </table>
    </worksheet>
    <worksheet name='Impact by Exception Type'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontname='Segoe UI Semibold' fontsize='11' bold='true'>Exception impact by type ($)</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Exceptions' name='federated.exceptions' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='federated.exceptions'>
          <column datatype='string' name='[exception_type]' role='dimension' type='nominal' />
          <column datatype='real' name='[impact_amount]' role='measure' type='quantitative' />
          <column datatype='string' name='[period]' role='dimension' type='nominal' />
          <column caption='Period Filter' datatype='boolean' name='[Calculation_excperiod]' role='dimension' type='ordinal'>
            <calculation class='tableau' formula='[Parameters].[Parameter 1] = &quot;All&quot; OR [period] = [Parameters].[Parameter 1]' />
          </column>
          <column-instance column='[exception_type]' derivation='None' name='[none:exception_type:nk]' pivot='key' type='nominal' />
          <column-instance column='[impact_amount]' derivation='Sum' name='[sum:impact_amount:qk]' pivot='key' type='quantitative' />
          <column-instance column='[Calculation_excperiod]' derivation='None' name='[none:Calculation_excperiod:ok]' pivot='key' type='ordinal' />
          </datasource-dependencies>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Period' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;All&quot;'>
              <calculation class='tableau' formula='&quot;All&quot;' />
            </column>
          </datasource-dependencies>
        <filter class='categorical' column='[federated.exceptions].[none:Calculation_excperiod:ok]'>
          <groupfilter function='member' level='[none:Calculation_excperiod:ok]' member='true' />
        </filter>
        <sort class='computed' column='[federated.exceptions].[none:exception_type:nk]' direction='DESC' using='[federated.exceptions].[sum:impact_amount:qk]' />
        <slices>
          <column>[federated.exceptions].[none:Calculation_excperiod:ok]</column>
        </slices>
          <aggregation value='true' />
        </view>
      <style />
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Bar' />
            <encodings>
              <color column='[federated.exceptions].[none:exception_type:nk]' />
            </encodings>
          </pane>
        </panes>
        <rows>[federated.exceptions].[none:exception_type:nk]</rows>
        <cols>[federated.exceptions].[sum:impact_amount:qk]</cols>
      </table>
    </worksheet>
    <worksheet name='Variance Trend'>
