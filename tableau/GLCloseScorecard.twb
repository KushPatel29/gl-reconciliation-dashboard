      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Exceptions' name='federated.exceptions' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='federated.exceptions'>
          <column datatype='string' name='[account_name]' role='dimension' type='nominal' />
          <column datatype='string' name='[exception_type]' role='dimension' type='nominal' />
          <column datatype='string' name='[period]' role='dimension' type='nominal' />
          <column datatype='real' name='[impact_amount]' role='measure' type='quantitative' />
          <column caption='Period Filter' datatype='boolean' name='[Calculation_excperiod]' role='dimension' type='ordinal'>
            <calculation class='tableau' formula='[Parameters].[Parameter 1] = &quot;All&quot; OR [period] = [Parameters].[Parameter 1]' />
          </column>
          <column-instance column='[account_name]' derivation='None' name='[none:account_name:nk]' pivot='key' type='nominal' />
          <column-instance column='[exception_type]' derivation='None' name='[none:exception_type:nk]' pivot='key' type='nominal' />
          <column-instance column='[impact_amount]' derivation='Sum' name='[sum:impact_amount:qk]' pivot='key' type='quantitative' />
          <column-instance column='[Calculation_excperiod]' derivation='None' name='[none:Calculation_excperiod:ok]' pivot='key' type='ordinal' />
          </datasource-dependencies>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Period' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;All&quot;'>
              <calculation class='tableau' formula='&quot;All&quot;' />
            </column>
          </datasource-dependencies>
        <filter class='categorical' column='[federated.exceptions].[none:Calculation_excperiod:ok]'>
          <groupfilter function='member' level='[none:Calculation_excperiod:ok]' member='true' />
        </filter>
        <sort class='computed' column='[federated.exceptions].[none:account_name:nk]' direction='DESC' using='[federated.exceptions].[sum:impact_amount:qk]' />
        <slices>
          <column>[federated.exceptions].[none:Calculation_excperiod:ok]</column>
        </slices>
          <aggregation value='true' />
        </view>
      <style />
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Text' />
            <encodings>
              <text column='[federated.exceptions].[sum:impact_amount:qk]' />
            </encodings>
          </pane>
        </panes>
        <rows>[federated.exceptions].[none:account_name:nk]</rows>
        <cols>[federated.exceptions].[none:exception_type:nk]</cols>
      </table>
    </worksheet>
    <worksheet name='KPI Exceptions'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontname='Segoe UI Semibold' fontsize='11' bold='true'>Open exceptions</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Exceptions' name='federated.exceptions' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='federated.exceptions'>
          <column datatype='string' name='[transaction_id]' role='dimension' type='nominal' />
          <column datatype='string' name='[period]' role='dimension' type='nominal' />
          <column caption='Total Exceptions' datatype='integer' name='[Calculation_exccount]' role='measure' type='quantitative'>
            <calculation class='tableau' formula='COUNT([transaction_id])' />
          </column>
          <column caption='Period Filter' datatype='boolean' name='[Calculation_excperiod]' role='dimension' type='ordinal'>
            <calculation class='tableau' formula='[Parameters].[Parameter 1] = &quot;All&quot; OR [period] = [Parameters].[Parameter 1]' />
          </column>
          <column-instance column='[Calculation_exccount]' derivation='User' name='[usr:Calculation_exccount:qk]' pivot='key' type='quantitative' />
          <column-instance column='[Calculation_excperiod]' derivation='None' name='[none:Calculation_excperiod:ok]' pivot='key' type='ordinal' />
          </datasource-dependencies>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Period' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;All&quot;'>
              <calculation class='tableau' formula='&quot;All&quot;' />
            </column>
          </datasource-dependencies>
        <filter class='categorical' column='[federated.exceptions].[none:Calculation_excperiod:ok]'>
          <groupfilter function='member' level='[none:Calculation_excperiod:ok]' member='true' />
        </filter>
        <slices>
          <column>[federated.exceptions].[none:Calculation_excperiod:ok]</column>
        </slices>
          <aggregation value='true' />
        </view>
      <style />
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Text' />
            <encodings>
              <text column='[federated.exceptions].[usr:Calculation_exccount:qk]' />
            </encodings>
          </pane>
        </panes>
        <rows></rows>
        <cols></cols>
      </table>
    </worksheet>
    <worksheet name='KPI Impact'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontname='Segoe UI Semibold' fontsize='11' bold='true'>Total exception impact ($)</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Exceptions' name='federated.exceptions' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='federated.exceptions'>
          <column datatype='real' name='[impact_amount]' role='measure' type='quantitative' />
          <column datatype='string' name='[period]' role='dimension' type='nominal' />
          <column caption='Period Filter' datatype='boolean' name='[Calculation_excperiod]' role='dimension' type='ordinal'>
            <calculation class='tableau' formula='[Parameters].[Parameter 1] = &quot;All&quot; OR [period] = [Parameters].[Parameter 1]' />
          </column>
          <column-instance column='[impact_amount]' derivation='Sum' name='[sum:impact_amount:qk]' pivot='key' type='quantitative' />
          <column-instance column='[Calculation_excperiod]' derivation='None' name='[none:Calculation_excperiod:ok]' pivot='key' type='ordinal' />
          </datasource-dependencies>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Period' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;All&quot;'>
              <calculation class='tableau' formula='&quot;All&quot;' />
            </column>
          </datasource-dependencies>
        <filter class='categorical' column='[federated.exceptions].[none:Calculation_excperiod:ok]'>
          <groupfilter function='member' level='[none:Calculation_excperiod:ok]' member='true' />
        </filter>
        <slices>
          <column>[federated.exceptions].[none:Calculation_excperiod:ok]</column>
        </slices>
          <aggregation value='true' />
        </view>
      <style />
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Text' />
            <encodings>
              <text column='[federated.exceptions].[sum:impact_amount:qk]' />
            </encodings>
          </pane>
        </panes>
        <rows></rows>
        <cols></cols>
      </table>
    </worksheet>
    <worksheet name='KPI Out of Tolerance'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontname='Segoe UI Semibold' fontsize='11' bold='true'>Account-periods out of tolerance</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Control Totals' name='federated.controltotals' />
