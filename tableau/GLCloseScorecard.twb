          <parent-name>[control_totals_tableau.csv]</parent-name>
          <remote-alias>variance_amount</remote-alias>
          <ordinal>7</ordinal>
          <local-type>real</local-type>
          <aggregation>Sum</aggregation>
          <contains-null>true</contains-null>
        </metadata-record>
        <metadata-record class='column'>
          <remote-name>variance_pct</remote-name>
          <remote-type>5</remote-type>
          <local-name>[variance_pct]</local-name>
          <parent-name>[control_totals_tableau.csv]</parent-name>
          <remote-alias>variance_pct</remote-alias>
          <ordinal>8</ordinal>
          <local-type>real</local-type>
          <aggregation>Sum</aggregation>
          <contains-null>true</contains-null>
        </metadata-record>
        <metadata-record class='column'>
          <remote-name>out_of_tolerance</remote-name>
          <remote-type>20</remote-type>
          <local-name>[out_of_tolerance]</local-name>
          <parent-name>[control_totals_tableau.csv]</parent-name>
          <remote-alias>out_of_tolerance</remote-alias>
          <ordinal>9</ordinal>
          <local-type>integer</local-type>
          <aggregation>Sum</aggregation>
          <contains-null>true</contains-null>
        </metadata-record>
        </metadata-records>
      </connection>
      <aliases enabled='yes' />
      <column datatype='string' name='[account_code]' role='dimension' type='nominal' />
      <column datatype='string' name='[account_name]' role='dimension' type='nominal' />
      <column datatype='string' name='[account_type]' role='dimension' type='nominal' />
      <column datatype='string' name='[statement]' role='dimension' type='nominal' />
      <column datatype='string' name='[period]' role='dimension' type='nominal' />
      <column datatype='real' default-format='#,##0' name='[erp_total]' role='measure' type='quantitative' />
      <column datatype='real' default-format='#,##0' name='[subledger_total]' role='measure' type='quantitative' />
      <column datatype='real' default-format='#,##0' name='[variance_amount]' role='measure' type='quantitative' />
      <column datatype='real' default-format='#,##0' name='[variance_pct]' role='measure' type='quantitative' />
      <column datatype='integer' default-format='#,##0' name='[out_of_tolerance]' role='measure' type='quantitative' />
      <column caption='Abs Variance' datatype='real' default-format='#,##0' name='[Calculation_absvariance]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ABS([variance_amount])' />
      </column>
      <column caption='Tolerance Status' datatype='string' name='[Calculation_tolerance]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [out_of_tolerance] = 1 THEN &quot;Out of tolerance&quot; ELSE &quot;Within tolerance&quot; END' />
      </column>
      <column caption='Out of Tolerance Rate' datatype='real' default-format='#,##0' name='[Calculation_ootrate]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([out_of_tolerance]) / COUNT([out_of_tolerance])' />
      </column>
      <column caption='Period Filter' datatype='boolean' name='[Calculation_ctlperiod]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 1] = &quot;All&quot; OR [period] = [Parameters].[Parameter 1]' />
      </column>
      <column-instance column='[Calculation_tolerance]' derivation='None' name='[none:Calculation_tolerance:nk]' pivot='key' type='nominal' />
      <layout dim-ordering='alphabetic' dim-percentage='0.5' measure-ordering='alphabetic' measure-percentage='0.4' show-structure='true' />
      <style>
        <style-rule element='mark'>
          <encoding attr='color' field='[none:Calculation_tolerance:nk]' type='palette'>
            <map to='#c0392b'>
              <bucket>&quot;Out of tolerance&quot;</bucket>
            </map>
            <map to='#12436d'>
              <bucket>&quot;Within tolerance&quot;</bucket>
            </map>
          </encoding>
        </style-rule>
      </style>
    </datasource>
