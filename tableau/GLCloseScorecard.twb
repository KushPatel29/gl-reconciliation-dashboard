        </named-connections>
        <relation connection='textscan.controltotals' name='control_totals_tableau.csv' table='[control_totals_tableau#csv]' type='table' />
        <metadata-records>
        <metadata-record class='column'>
          <remote-name>account_code</remote-name>
          <remote-type>130</remote-type>
          <local-name>[account_code]</local-name>
